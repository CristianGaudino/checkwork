---
import { site, nav } from '../config';
import { projects } from '../data/projects';
const year = new Date().getFullYear();
const { companyName, companyNumber, registeredOffice } = site.legal;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand-link" href="/" aria-label="Checkwork, home">
          <img src="/brand/checkwork-logo-on-dark.svg" alt="" width="160" height="25" style="height:25px" />
        </a>
        <p style="margin-top:1rem;max-width:26em">{site.description}</p>
      </div>
      <div>
        <h2>Site</h2>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Work</h2>
        <ul>
          {projects.map((p) => <li><a href={`/work/${p.slug}`}>{p.name}</a></li>)}
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>
        © {year} {companyName}{companyNumber ? `. Registered in Ireland, company number ${companyNumber}` : ''}{registeredOffice ? `. Registered office: ${registeredOffice}` : ''}
      </span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>
