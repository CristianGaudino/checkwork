---
// A screenshot slot. Pass `src` once you have a real image in /public/work/...
// Without `src` it shows a clearly marked placeholder (never a fake screenshot).
const { src, alt, caption, label, hint } = Astro.props;
---
<figure class="frame">
  <div class="frame-body">
    {src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" width="1600" height="1000" />
    ) : (
      <div class="frame-empty" role="img" aria-label={alt}>
        <strong>{label}</strong>
        <span>Screenshot to add{hint ? `: ${hint}` : ''}</span>
      </div>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
