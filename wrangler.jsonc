{
	// The site on Cloudflare Workers, built by OpenNext (`npx opennextjs-cloudflare build`).
	// Secrets (DATABASE_URL, TURNSTILE_SECRET_KEY) are set on the Worker in the dashboard, never here.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checkwork",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "checkwork" }],
	// Plain values live here: every `wrangler deploy` replaces the dashboard's plain-text variables with these.
	"vars": { "APP_ENV": "production" },
	"routes": [{ "pattern": "checkwork.cgaudino.com", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": true }
}
