{
	// The site on Cloudflare Workers, built by OpenNext (`npx opennextjs-cloudflare build`).
	// Secrets (TURNSTILE_SECRET_KEY) are set on the Worker in the dashboard, never here.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checkwork",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "checkwork" }],
	// Plain values live here: every `wrangler deploy` replaces the dashboard's plain-text variables with these.
	"vars": { "APP_ENV": "production" },
	"routes": [{ "pattern": "checkwork.cgaudino.com", "custom_domain": true }],
	"workers_dev": false,
	// Enquiries: an EU-jurisdiction D1 database (created with --jurisdiction eu; that cannot be changed later).
	"d1_databases": [{ "binding": "DB", "database_name": "checkwork", "database_id": "2d6e67b3-0142-4cec-bcb1-5d024de8327d", "migrations_dir": "drizzle" }],
	// Enquiry alert email (issue #28). Sent from ENQUIRY_ALERT_FROM in src/lib/config.ts to the ENQUIRY_ALERT_TO secret.
	"send_email": [{ "name": "EMAIL" }],
	"observability": { "enabled": true }
}
